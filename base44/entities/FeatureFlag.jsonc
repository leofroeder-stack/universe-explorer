{
  "name": "FeatureFlag",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique identifier for the feature (e.g. 'measurements', 'ar_view')"
    },
    "name": {
      "type": "string",
      "description": "Human-readable name of the feature"
    },
    "enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether this feature is currently enabled"
    },
    "description": {
      "type": "string",
      "description": "Optional description of what this feature does"
    }
  },
  "required": [
    "key",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}